# Скопируйте в .env. Файл .env не коммитится.
# Аккаунты Threads, их токены, темы и время публикации настраиваются в окне бота (Historian.bat)
# и хранятся в папке accounts/. Значения ниже нужны только при первом запуске:
# из них бот создаёт первый аккаунт.
HISTORIAN_PUBLISH=false
HISTORIAN_LANGUAGE=українська
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
